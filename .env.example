# Required in production. Generate a long random value and never commit it.
JWT_SECRET=replace-with-a-long-random-secret

# Local demo storage. Future providers can implement IPFS or Filecoin.
STORAGE_PROVIDER=local

# Raw AES keys are only permitted for local demo flows.
ALLOW_RAW_KEYS=false
NEXT_PUBLIC_ALLOW_DEMO_RAW_KEYS=false
