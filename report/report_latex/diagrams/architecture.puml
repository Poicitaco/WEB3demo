@startuml
skinparam defaultFontName "TeX Gyre Termes"
skinparam shadowing false
skinparam componentStyle rectangle
top to bottom direction
skinparam rectangle {
  BackgroundColor #FBF8F3
  BorderColor #2E2A27
}
skinparam database {
  BackgroundColor #F1EDFF
  BorderColor #5F4BDB
}

rectangle "TẦNG TRÌNH DUYỆT" as Browser {
  component "React UI\nDashboard - Upload - Viewer" as UI
  component "MetaMask\nKý nonce" as MM
  component "Web Crypto API\nMã hóa và giải mã phía client" as Crypto
}

rectangle "TẦNG ỨNG DỤNG NEXT.JS" as App {
  component "Auth API\nNonce và JWT session" as Auth
  component "Files + Tokens API\nMetadata và vòng đời quyền" as Files
  component "Approvals API\nPhê duyệt K-of-N" as Approvals
  component "Storage API\nUpload và lấy ciphertext" as StorageAPI
  component "Audit API\nNhật ký bất biến" as Audit
}

rectangle "TẦNG DỮ LIỆU" as Data {
  database "SQLite\nMetadata, token, approval, audit" as DB
  cloud "Cloudflare R2\nChỉ lưu ciphertext" as R2
}

UI --> MM : yêu cầu ký
UI --> Crypto : mã hóa / giải mã file
UI --> Auth
UI --> Files
UI --> Approvals
UI --> StorageAPI
UI --> Audit

Auth --> DB
Files --> DB
Approvals --> DB
Audit --> DB
StorageAPI --> DB : kiểm tra token / quyền
StorageAPI --> R2 : put / get ciphertext
@enduml
