@startuml
skinparam defaultFontName "TeX Gyre Termes"
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype ortho
skinparam usecase {
  BackgroundColor #F7F4EF
  BorderColor #2E2A27
  ArrowColor #5F4BDB
}

actor "A\nChủ sở hữu" as Owner
actor "B\nNgười phê duyệt" as Reviewer
actor "C\nNgười nhận" as Recipient
rectangle "Cloudflare R2\n<<external system>>" as R2 #F1EDFF

rectangle "WEB3demo" {
  usecase "Đăng nhập bằng ví" as UCAuth
  usecase "Đăng ký định danh mã hóa" as UCIdentity
  usecase "Upload và mã hóa tài liệu" as UCUpload
  usecase "Quản lý kho nhóm" as UCVault
  usecase "Thiết lập phê duyệt ngưỡng" as UCThreshold
  usecase "Tạo yêu cầu truy cập" as UCRequest
  usecase "Phê duyệt yêu cầu" as UCApprove
  usecase "Cấp approval token" as UCToken
  usecase "Mở tài liệu trong viewer" as UCView
  usecase "Thu hồi token" as UCRevoke
  usecase "Hủy tài liệu" as UCDestroy
  usecase "Xem audit trail" as UCAudit
  usecase "Lưu ciphertext" as UCStore
}

Owner --> UCAuth
Reviewer --> UCAuth
Recipient --> UCAuth
Owner --> UCIdentity
Reviewer --> UCIdentity
Recipient --> UCIdentity
Owner --> UCUpload
Owner --> UCVault
Owner --> UCThreshold
Recipient --> UCRequest
Owner --> UCApprove
Reviewer --> UCApprove
UCApprove ..> UCToken : <<include>>\nkhi đủ ngưỡng
Recipient --> UCView
Owner --> UCRevoke
Owner --> UCDestroy
Owner --> UCAudit
Reviewer --> UCAudit
Recipient --> UCAudit
UCUpload ..> UCStore : <<include>>
UCStore --> R2
@enduml
